#!/bin/bash
# Sincroniza Vesktop (Discord) con el tema actual de Omarchy via QuickCSS.
#
# No tocamos settings.json: Vencord lo lee UNA sola vez al arrancar y lo
# reescribe entero desde memoria en cuanto cambia cualquier ajuste, asi que una
# edicion externa no se ve hasta un reinicio completo del proceso (y con
# minimizeToTray activo, cerrar la ventana no reinicia nada).
#
# QuickCSS en cambio esta vigilado con fs.watch (src/main/ipcMain.ts,
# INIT_FILE_WATCHERS) y se recarga en caliente. Redefinimos --theme-h/s/l, las
# tres variables sobre las que el plugin ClientTheme reconstruye todos los
# --neutral-*-hsl de Discord.
#
# Requisitos, una sola vez en la UI de Vesktop:
#   Vencord > Themes  > Enable QuickCSS
#   Vencord > Plugins > ClientTheme (activado)

set -e

QUICK_CSS="$HOME/.config/vesktop/settings/quickCss.css"
COLORS_FILE="$HOME/.config/omarchy/current/theme/colors.toml"

[[ -d ${QUICK_CSS%/*} ]] || exit 0
[[ -f $COLORS_FILE ]] || exit 0
command -v python3 >/dev/null || exit 0

BACKGROUND=$(sed -n 's/^background = //p' "$COLORS_FILE" | tr -d '"#')
BACKGROUND=${BACKGROUND:-282828}

BACKGROUND="$BACKGROUND" QUICK_CSS="$QUICK_CSS" python3 <<'PY'
import colorsys, os, re

hexcode = os.environ["BACKGROUND"][:6]
r, g, b = (int(hexcode[i:i + 2], 16) / 255 for i in (0, 2, 4))
h, l, s = colorsys.rgb_to_hls(r, g, b)

block = f"""/* omarchy:begin - generado por hooks/theme-set.d/vesktop-theme */
:root:root {{
    --theme-h: {h * 360:.0f};
    --theme-s: {s * 100:.1f}%;
    --theme-l: {l * 100:.1f}%;
}}
/* omarchy:end */"""

path = os.environ["QUICK_CSS"]
try:
    css = open(path).read()
except OSError:
    css = ""

# Sustituye solo nuestro bloque; el CSS que hayas escrito tu se conserva.
css = re.sub(r"/\* omarchy:begin.*?/\* omarchy:end \*/\n?", "", css, flags=re.S).strip()
open(path, "w").write((block + "\n\n" + css).strip() + "\n")
PY

echo "Vesktop QuickCSS actualizado desde #$BACKGROUND"
